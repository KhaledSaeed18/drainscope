<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  io.github.khaledsaeed18.Drainscope.Probe1

  Kernel activity counted with eBPF (ADR 0006), served on the system bus by drainscope-probe:

    bus name     io.github.khaledsaeed18.Drainscope.Probe
    object path  /io/github/khaledsaeed18/Drainscope/Probe

  Every call is authorized by polkit (io.github.khaledsaeed18.Drainscope.read-activity, active
  local sessions only) and rate-limited per user. Errors use the
  io.github.khaledsaeed18.Drainscope.Error.* names of Sampler1.
-->
<node>
  <interface name="io.github.khaledsaeed18.Drainscope.Probe1">
    <!--
      ReadWakeups:
        monotonic_ns  CLOCK_MONOTONIC when the counters were read.
        generation    Changes whenever the counters restart from zero (e.g. the probe
                      restarted). Only compare readings of the same generation.
        wakeups       (cgroup path relative to /sys/fs/cgroup, "" for the root; cumulative
                      idle exits) for every cgroup that left a CPU's idle task at least once.
                      Other users' cgroups (user.slice/user-UID.slice for another UID) are
                      never included.
    -->
    <method name="ReadWakeups">
      <arg name="monotonic_ns" type="t" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="wakeups" type="a(st)" direction="out"/>
    </method>
    <!--
      ReadNetwork: like ReadWakeups, for network traffic outside loopback.
        traffic  (cgroup path, cumulative bytes received, cumulative bytes sent) by the cgroup
                 of the socket's owner. Fails with Unsupported when the network programs
                 couldn't be attached.
    -->
    <method name="ReadNetwork">
      <arg name="monotonic_ns" type="t" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="traffic" type="a(stt)" direction="out"/>
    </method>
    <!--
      ReadNetworkTime: CPU time the kernel spent in the network softirqs (the network stack's
      work, which cgroup accounting charges to no app), machine-wide, cumulative.
        tx_ns, rx_ns  Nanoseconds in NET_TX and NET_RX. Fails with Unsupported like ReadNetwork.
    -->
    <method name="ReadNetworkTime">
      <arg name="monotonic_ns" type="t" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="tx_ns" type="t" direction="out"/>
      <arg name="rx_ns" type="t" direction="out"/>
    </method>
    <!--
      ReadAll: ReadWakeups, ReadNetwork and ReadNetworkTime in one call, from one reading of the
      counters, so a client that polls all three needs one round trip instead of three.
        network_available  False when the network programs couldn't be attached or read; traffic
                           is then empty and tx_ns, rx_ns are 0. Wakeups still come through.
      Other arguments as in the three methods. Added after 0.1.2: clients should fall back to the
      three methods when an older probe answers UnknownMethod.
    -->
    <method name="ReadAll">
      <arg name="monotonic_ns" type="t" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="wakeups" type="a(st)" direction="out"/>
      <arg name="network_available" type="b" direction="out"/>
      <arg name="traffic" type="a(stt)" direction="out"/>
      <arg name="tx_ns" type="t" direction="out"/>
      <arg name="rx_ns" type="t" direction="out"/>
    </method>
    <!-- MinIntervalMs: the shortest allowed interval between calls to each method from one user. -->
    <property name="MinIntervalMs" type="u" access="read"/>
  </interface>
</node>
