<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  io.github.khaledsaeed18.Drainscope.Monitor1

  Energy usage per consumer, served by the drainscope user daemon on the session bus:

    bus name     io.github.khaledsaeed18.Drainscope.Monitor
    object path  /io/github/khaledsaeed18/Drainscope/Monitor

  Consumers are identified by their storage key (e.g. "app:org.mozilla.firefox",
  "unit:NetworkManager.service", "devices"); see drainscope-model's ConsumerKey. Energy is in
  joules; timestamps are Unix seconds.
-->
<node>
  <interface name="io.github.khaledsaeed18.Drainscope.Monitor1">
    <!--
      GetSummary: the battery story since the charger was last unplugged.
        on_battery        Whether the machine is discharging now.
        since_unplug      When the current (or last) discharge started.
                          0 if no unplug was ever recorded.
        battery_percent   Battery percentage used since then: what the batteries lost, against
                          their full capacity, including time the daemon wasn't running. Falls
                          back to the measured energy when the batteries don't report energy.
        top               (key, joules, percent of battery, percent of attributable energy)
                          for the largest consumers, largest first.
    -->
    <method name="GetSummary">
      <arg name="on_battery" type="b" direction="out"/>
      <arg name="since_unplug" type="x" direction="out"/>
      <arg name="battery_percent" type="d" direction="out"/>
      <arg name="top" type="a(sddd)" direction="out"/>
    </method>
    <!--
      GetUsage: energy per consumer over [since, until).
        group_by      "consumer" (each key) or "kind" (app, unit, terminal, ...).
        power_source  "any", "battery" or "ac".
        usage         (key, kind, total J, cpu J, gpu J, other J), largest first.
    -->
    <method name="GetUsage">
      <arg name="since" type="x" direction="in"/>
      <arg name="until" type="x" direction="in"/>
      <arg name="group_by" type="s" direction="in"/>
      <arg name="power_source" type="s" direction="in"/>
      <arg name="usage" type="a(ssdddd)" direction="out"/>
    </method>
    <!--
      GetCoverage: how much of [since, until) the daemon actually measured, in seconds (it
      may not have been running all the time). Use it to turn GetUsage totals into averages.
    -->
    <method name="GetCoverage">
      <arg name="since" type="x" direction="in"/>
      <arg name="until" type="x" direction="in"/>
      <arg name="power_source" type="s" direction="in"/>
      <arg name="seconds" type="t" direction="out"/>
    </method>
    <!--
      GetSleepSessions: suspends that started at or after `since`.
        sessions  (start, end, Wh lost, percent lost, sleep mode); unknown amounts are NaN
                  and an unknown mode is ""
    -->
    <method name="GetSleepSessions">
      <arg name="since" type="x" direction="in"/>
      <arg name="sessions" type="a(xxdds)" direction="out"/>
    </method>
    <!--
      GetSleepHistory: GetSleepSessions plus why the machine woke.
        sessions  (start, end, Wh lost, percent lost, sleep mode, wake reason); unknown amounts
                  are NaN, an unknown mode or wake reason is "". The wake reason is readable
                  text, e.g. "Lid (PNP0C0D:00)" or "IRQ 9 (acpi)".
    -->
    <method name="GetSleepHistory">
      <arg name="since" type="x" direction="in"/>
      <arg name="sessions" type="a(xxddss)" direction="out"/>
    </method>
    <!--
      GetBatteryHealth: one reading per battery per day, at or after `since`, oldest first.
        readings  (battery, time, full-charge Wh, design Wh, charge cycles); an unknown design
                  capacity is NaN and unknown cycles are 0.
    -->
    <method name="GetBatteryHealth">
      <arg name="since" type="x" direction="in"/>
      <arg name="readings" type="a(sxddu)" direction="out"/>
    </method>
    <!--
      GetWakeups: which consumers keep waking the processor from idle, from the eBPF probe.
        available  False when the probe isn't installed or reachable; wakeups is then empty.
        wakeups    (key, idle exits per second over the last minute), largest first.
    -->
    <method name="GetWakeups">
      <arg name="available" type="b" direction="out"/>
      <arg name="wakeups" type="a(sd)" direction="out"/>
    </method>
    <!--
      GetNetwork: network traffic outside loopback by consumer, from the eBPF probe.
        available  False when the probe or its network counting isn't available; traffic is
                   then empty.
        traffic    (key, bytes received per second, bytes sent per second) over the last
                   minute, busiest first.
    -->
    <method name="GetNetwork">
      <arg name="available" type="b" direction="out"/>
      <arg name="traffic" type="a(sdd)" direction="out"/>
    </method>
    <!--
      SetFocus: the app now in focus (ADR 0011), from the GNOME Shell extension.
        app_id  Desktop ID without ".desktop" (e.g. "org.mozilla.firefox"), or "" when nothing
                has focus (desktop, Overview, lock screen).
      Accepted only from the GNOME Shell process (the PID of org.gnome.Shell's owner); others
      get AccessDenied. Added after 0.1.3.
    -->
    <method name="SetFocus">
      <arg name="app_id" type="s" direction="in"/>
    </method>
    <!--
      EndFocus: focus is no longer reported (the extension was turned off), so it is unknown
      from now on. Same caller rule as SetFocus. Added after 0.1.3.
    -->
    <method name="EndFocus"/>
    <!--
      GetFocus: how apps' energy over [since, until) splits by focus. Join with GetUsage: an
      app's background energy is its total there minus foreground and unknown here. Apps
      missing here have no known split. Added after 0.1.3.
        power_source  "any", "battery" or "ac".
        focus         (key, joules while focused, joules while focus was unknown, focused seconds).
    -->
    <method name="GetFocus">
      <arg name="since" type="x" direction="in"/>
      <arg name="until" type="x" direction="in"/>
      <arg name="power_source" type="s" direction="in"/>
      <arg name="focus" type="a(sddt)" direction="out"/>
    </method>
    <!--
      Tick: emitted after every attribution tick, for live views.
        duration_ms  Length of the tick.
        usage        (key, watts) for consumers active during the tick.
    -->
    <signal name="Tick">
      <arg name="duration_ms" type="u"/>
      <arg name="usage" type="a(sd)"/>
    </signal>
    <!-- Status: "full" (RAPL and battery), "battery-only" (no sampler) or "time-only" (AC, no sampler). -->
    <property name="Status" type="s" access="read"/>
    <!-- ModelVersion: version of the attribution model producing new data. -->
    <property name="ModelVersion" type="u" access="read"/>
    <!-- Domains: RAPL domains in use (psys appears only if it passed the plausibility check). -->
    <property name="Domains" type="as" access="read"/>
  </interface>
</node>
