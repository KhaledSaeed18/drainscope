<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  io.github.khaledsaeed18.Drainscope.Sampler1

  RAPL energy counters, which sysfs makes root-only (CVE-2020-8694). Served by the sandboxed
  drainscope-sampler system service on the system bus:

    bus name     io.github.khaledsaeed18.Drainscope.Sampler
    object path  /io/github/khaledsaeed18/Drainscope/Sampler

  Every call is authorized with polkit action io.github.khaledsaeed18.Drainscope.read-energy
  (active local sessions only), rate-limited per caller to MinIntervalMs, and quantized to
  QuantumUj, keeping the counters far too coarse for the Platypus side channel.

  Errors (prefix io.github.khaledsaeed18.Drainscope.Error.):
    NotAuthorized  polkit denied the caller
    RateLimited    called again within MinIntervalMs
    Unsupported    no RAPL zones on this machine
    Failed         reading the counters failed
-->
<node>
  <interface name="io.github.khaledsaeed18.Drainscope.Sampler1">
    <!--
      ReadCounters:
        monotonic_ns  CLOCK_MONOTONIC when the counters were read.
        generation    Changes whenever the counters restart from zero (e.g. the sampler
                      restarted). Only compare readings of the same generation.
        counters      (domain, cumulative microjoules) per RAPL domain: "package", "core",
                      "uncore", "dram", "psys". Never decrease within a generation (counter
                      wraparound is handled by the sampler) and are rounded down to QuantumUj.
    -->
    <method name="ReadCounters">
      <arg name="monotonic_ns" type="t" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="counters" type="a(st)" direction="out"/>
    </method>
    <!-- Domains: the RAPL domains this machine reports. -->
    <property name="Domains" type="as" access="read"/>
    <!-- MinIntervalMs: the shortest allowed interval between calls from one caller. -->
    <property name="MinIntervalMs" type="u" access="read"/>
    <!-- QuantumUj: counters are rounded down to multiples of this many microjoules. -->
    <property name="QuantumUj" type="t" access="read"/>
  </interface>
</node>
